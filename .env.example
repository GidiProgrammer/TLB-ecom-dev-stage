# Client (Vite inlines VITE_* into the browser bundle)
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_or_publishable_key_here

# Server / SSR
SUPABASE_URL=your_supabase_url_here
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_or_publishable_key_here

# Server only — never prefix with VITE_ or import into client components
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Server-only mail. Never prefix with VITE_.
# Preview / staging: MAIL_DRIVER=capture (no provider key required; no real email).
# Production: MAIL_DRIVER=resend plus MAIL_FROM and MAIL_PROVIDER_API_KEY.
MAIL_DRIVER=capture

# Verified sender, e.g. TLB Enterprise <notices@your-verified-domain>
# Required when MAIL_DRIVER=resend. Leave empty for capture.
MAIL_FROM=

# Optional default Reply-To when an event does not set payload.replyTo
MAIL_REPLY_TO=

# Resend API key. Server only. Required when MAIL_DRIVER=resend. Never commit a real value.
MAIL_PROVIDER_API_KEY=

# Server only. Staff inbox for contact.submitted. Must be a valid email.
# Never prefix with VITE_. Do not use a real customer or employee address in git.
# If unset, contact submission fails with a configuration error (nothing is routed).
CONTACT_RECIPIENT_EMAIL=

# Server only. Bearer secret for POST/GET /api/cron/transactional-email.
# Required on any host that invokes the processor. Missing secret → HTTP 500 (fail closed).
# Vercel Cron sends Authorization: Bearer $CRON_SECRET when this variable is set.
CRON_SECRET=

# Optional leftover Lovable placeholders (unused by the transactional email processor)
LOVABLE_CRON_SECRET=your_lovable_cron_secret_here
LOVABLE_CRON_SECRET_PREVIOUS=your_previous_lovable_cron_secret_here

# Optional Playwright authenticated E2E — dedicated test user only, never a real customer.
# Do not commit real values.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# Client (Vite inlines VITE_* into the browser bundle)
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_or_publishable_key_here

# Server / SSR
SUPABASE_URL=your_supabase_url_here
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_or_publishable_key_here

# Server only — never prefix with VITE_ or import into client components
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Optional: Lovable cron auth (server-only)
LOVABLE_CRON_SECRET=your_lovable_cron_secret_here
LOVABLE_CRON_SECRET_PREVIOUS=your_previous_lovable_cron_secret_here
